# Скопируй в .env и впиши свои ключи. Файл .env НЕ коммитится (см. .gitignore).
# Любой источник без ключа просто пропускается — процесс не падает.

# ── Данные о компаниях ───────────────────────────────────────────────
# СПАРК-Интерфакс (премиум, авторитетные финансы/риски/аффилированность).
# При заданных кредах подменяет/дополняет бесплатные источники.
SPARK_API_URL=https://api.spark-interfax.ru/SparkApi
SPARK_API_LOGIN=
SPARK_API_PASSWORD=

# OFData — агрегатор (бесплатный тариф 100 запр./сут): риски, реквизиты
OFDATA_KEY=
# Dadata — базовая карточка (free 10000/сут)
DADATA_TOKEN=
DADATA_SECRET=
# Опционально
CHECKO_KEY=
FSSP_TOKEN=
MONEYPLACE_TOKEN=

# ── Генерация контента и оценки (LLM) ────────────────────────────────
# Polza AI — OpenAI-совместимый API (https://polza.ai/docs/api-reference/introduction).
POLZA_BASE_URL=https://api.polza.ai/api/v1
POLZA_API_KEY=
POLZA_MODEL=openai/gpt-5

# ── Рассылка тизеров ─────────────────────────────────────────────────
# Telegram Bot API (приём запросов в bot.py + исходящая доставка в telegram_sender.py)
TELEGRAM_BOT_TOKEN=

# Почта (SMTP) для исходящих писем с вложенным тизером
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
